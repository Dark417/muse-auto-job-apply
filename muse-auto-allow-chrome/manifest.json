{
  "manifest_version": 3,
  "name": "Muse Auto Allow",
  "version": "1.2.0",
  "description": "Clicks Allow on Muse's \"Needs review\" approval prompts in an open muse.ai tab.",
  "permissions": ["alarms", "storage", "scripting"],
  "host_permissions": ["https://muse.ai/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Muse Auto Allow" }
}
